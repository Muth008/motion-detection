# =============================================================================
# Camera connection settings
# =============================================================================
# Copy this file to ".env" and fill in real values.
# The .env file MUST NOT be committed to version control - it is in .gitignore.

# IP address of the Reolink camera on the local network
CAMERA_HOST=192.168.1.100

# RTSP/HTTPS credentials configured on the camera
CAMERA_USERNAME=admin
CAMERA_PASSWORD=

# RTSP port (Reolink default: 554)
CAMERA_RTSP_PORT=554

# Stream selection: "sub" (low-resolution H.264) or "main" (high-resolution H.265)
RTSP_STREAM=sub

# Optional human-readable camera label (used in evaluator outputs)
CAMERA_NAME=porch

# =============================================================================
# Reolink HTTPS API (only needed when running reolink_collector.py)
# =============================================================================
# By default the same host/credentials as CAMERA_* are used. Override here
# only if the Reolink HTTPS endpoint is different from the RTSP one.
# REOLINK_HOST=192.168.1.100
# REOLINK_USERNAME=admin
# REOLINK_PASSWORD=
REOLINK_PORT=443
REOLINK_CHANNEL=0
